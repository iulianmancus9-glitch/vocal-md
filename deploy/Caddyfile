# Configurarea pentru Caddy.
#
# Site-ul stă pe golura.io — domeniul aprobat de Paddle pentru exact acest
# produs. vocal.md rămâne cumpărat și trimite vizitatorii acolo, ca linkurile
# vechi și cine îl tastează din memorie să ajungă unde trebuie.
#
# ─────────────────────────────────────────────────────────────────────────
#  CAZUL 1 — Caddy rulează ÎN CONTAINER (verifici cu: docker ps | grep caddy)
# ─────────────────────────────────────────────────────────────────────────
#
# Pentru un program din container, `127.0.0.1` înseamnă containerul însuși, nu
# serverul. Deci Caddy trebuie să caute site-ul pe nume de container, iar pentru
# asta cele două containere trebuie să fie în aceeași rețea Docker:
#
#     docker network connect vocal-md_default <numele-containerului-caddy>
#
# Apoi folosește blocurile de mai jos AȘA CUM SUNT.

golura.io, www.golura.io {
	encode zstd gzip

	# Fără `header_up X-Real-IP` aici, dinadins.
	#
	# Blocul vechi muta CF-Connecting-IP în X-Real-IP, pentru că vocal.md stătea
	# în spatele Cloudflare. golura.io merge direct de la Namecheap la server,
	# deci antetul acela nu există — iar dacă l-am seta oricum, ar pleca gol, și
	# toți vizitatorii ar ajunge în aceeași găleată de limitare.
	#
	# Caddy pune singur X-Forwarded-For, de unde aplicația citește adresa.
	reverse_proxy vocal-md-web-1:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format json
	}
}

# Domeniul vechi. 308 păstrează metoda și calea, deci un link adânc
# (vocal.md/comanda/abc?t=…) ajunge la aceeași pagină pe golura.io, cu tot cu
# secretul din adresă.
vocal.md, www.vocal.md {
	redir https://golura.io{uri} 308
}

# ─────────────────────────────────────────────────────────────────────────
#  CAZUL 2 — Caddy e instalat pe server (există /etc/caddy/Caddyfile)
# ─────────────────────────────────────────────────────────────────────────
#
# Atunci Caddy și site-ul sunt pe aceeași mașină, deci schimbi o singură linie:
#
#     reverse_proxy 127.0.0.1:3000
#
# și scoți blocul `log`, pentru că un Caddy de sistem scrie deja în jurnalul lui.
