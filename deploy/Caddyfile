# Configurarea pentru Caddy.
#
# Site-ul stă pe vocal.md. A existat un plan de mutare pe golura.io, pentru că
# acela era domeniul aprobat de Paddle; s-a renunțat, pentru că plata merge
# acum prin Paynet, care nu are nicio legătură cu domeniul. Blocul pentru
# golura.io a rămas comentat mai jos, dacă vreodată se revine.
#
# ─────────────────────────────────────────────────────────────────────────
#  CAZUL 1 — Caddy rulează ÎN CONTAINER (verifici cu: docker ps | grep caddy)
# ─────────────────────────────────────────────────────────────────────────
#
# Pentru un program din container, `127.0.0.1` înseamnă containerul însuși, nu
# serverul. Deci Caddy trebuie să caute site-ul pe nume de container, iar pentru
# asta cele două containere trebuie să fie în aceeași rețea Docker:
#
#     docker network connect vocal-md_default <numele-containerului-caddy>
#
# Apoi folosește blocul de mai jos AȘA CUM E.

vocal.md, www.vocal.md {
	encode zstd gzip

	reverse_proxy vocal-md-web-1:3000 {
		# Cloudflare stă în față, deci IP-ul real al vizitatorului vine de la el.
		#
		# Linia asta se scoate dacă domeniul NU mai trece prin Cloudflare:
		# altfel antetul pleacă gol, iar toți vizitatorii ajung în aceeași
		# găleată de limitare. Fără ea, Caddy pune singur X-Forwarded-For, de
		# unde aplicația citește adresa la fel de bine.
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format json
	}
}

# Dacă vreodată se mută pe alt domeniu, vechiul îl trimite pe noul, iar 308
# păstrează calea — deci un link adânc către o comandă ajunge la aceeași pagină,
# cu tot cu secretul din adresă:
#
# vocal.md, www.vocal.md {
# 	redir https://golura.io{uri} 308
# }

# ─────────────────────────────────────────────────────────────────────────
#  CAZUL 2 — Caddy e instalat pe server (există /etc/caddy/Caddyfile)
# ─────────────────────────────────────────────────────────────────────────
#
# Atunci Caddy și site-ul sunt pe aceeași mașină, deci schimbi o singură linie:
#
#     reverse_proxy 127.0.0.1:3000 {
#
# și scoți blocul `log`, pentru că un Caddy de sistem scrie deja în jurnalul lui.
