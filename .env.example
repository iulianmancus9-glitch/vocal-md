# ══════════════════════════════════════════════════════════════
#  VOCAL MD — configurare
#  Copiază acest fișier în .env și completează valorile.
#  Nu urca niciodată .env în git.
# ══════════════════════════════════════════════════════════════

# ─── Site ───
NODE_ENV=production
APP_URL=https://vocal.md
# Secret pentru semnarea linkurilor de descărcare și a cookie-urilor de sesiune.
# Generează-l o singură dată cu:  openssl rand -hex 32
APP_SECRET=schimba-ma-openssl-rand-hex-32

# Limba paginii pentru vizitatorii al căror browser nu cere nici română, nici
# engleză. Cine cere română primește română oricum, iar butonul din antet bate
# tot și se ține minte într-un cookie.
#
# Acum e „en", pentru verificarea făcută de procesatorul de plăți: se uită peste
# site din străinătate, iar un om care nu înțelege pagina nu poate confirma ce se
# vinde pe ea. După aprobare se pune „ro" aici și se repornește — nimic altceva.
DEFAULT_LANG=ro

# ─── Baza de date ───
# În docker compose, hostul este numele serviciului: "db".
DATABASE_URL=postgres://vocal:PAROLA@db:5432/vocalmd
POSTGRES_USER=vocal
POSTGRES_PASSWORD=PAROLA
POSTGRES_DB=vocalmd

# ─── Versuri: Gemini prin OpenRouter ───
OPENROUTER_API_KEY=
GEMINI_MODEL=google/gemini-3.1-pro-preview
GEMINI_TEMPERATURE=0.9

# ─── Melodie: sunoapi.org ───
SUNO_API_KEY=
SUNO_MODEL=V6
# Suno cere obligatoriu un callBackUrl public. Îl verificăm prin semnătură.
SUNO_CALLBACK_URL=https://vocal.md/api/suno/callback

# ─── Fișiere audio ───
# Cale în container; în compose e montat volumul ./data/audio
STORAGE_DIR=/data/audio
PREVIEW_SECONDS=60
# Cât timp e valabil un link de descărcare semnat (secunde). 24h.
DOWNLOAD_LINK_TTL=86400

# ─── Plata: link fix MAIB ───
# Linkul de plată generat în MAIB. Cât timp lipsește, site-ul pornește normal,
# dar butonul de cumpărare spune că plata nu e disponibilă.
# Linkul e același pentru toți clienții și nu ne anunță nimic când se plătește:
# confirmarea o dai tu, de pe Telegram, după ce vezi banii în cont.
MAIB_PAY_URL=
SONG_PRICE_EUR=30

# ─── Telegram: notificări și butonul de deblocare ───
# BOT_TOKEN  — de la @BotFather, după /newbot
# CHAT_ID    — al tău, de la @userinfobot
# SECRET     — îl inventezi tu; Telegram îl trimite înapoi la fiecare apăsare,
#              iar fără el oricine ar putea debloca melodii. Generează-l cu:
#              openssl rand -hex 32
# Fără ele site-ul merge, dar deblocarea s-ar face intrând pe server.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# ─── Export pentru Google Sheets ───
# Generat automat de setup.sh. Apare în adresa pusă în foaie, deci nu-l folosi
# pentru nimic altceva.
EXPORT_KEY=

# ─── Email ───
# Adresa din MAIL_FROM trebuie să fie pe un domeniu verificat în Resend.
# Fără cheie, melodia rămâne în pagină dar nu pleacă niciun email.
RESEND_API_KEY=
MAIL_FROM=Vocal MD <comenzi@vocal.md>
MAIL_REPLY_TO=base.vocalmd@gmail.com

# ─── Câte reluări are voie clientul ───
# Versuri: câte variante noi poate cere înainte de a aproba textul.
MAX_LYRICS_REGENS=2
# Melodie: câte înregistrări în plus poate cere după prima.
# Fiecare costă credite Suno reale, pe o comandă care poate să nu se cumpere.
MAX_EXTRA_RENDERS=2

# Cât primește din nou, după ce plătește. La confirmarea plății contoarele
# comenzii se pun la loc: a dat 30 €, deci poate cere încă o interpretare a
# aceleiași piese. Costă în continuare credite Suno, de asta nu e nelimitat.
PAID_EXTRA_RENDERS=3
PAID_EXTRA_REGENS=3

# ─── Limite anti-abuz ───
# Previzualizarea e gratuită dar costă credite Suno reale.
#
# Se numără pe patru niveluri, în ordinea asta:
#
#  1. PE TOT SITE-UL — frâna de mână pe bani. E singura limită pe care n-o
#     poate ocoli nimeni: nici cine șterge cookie-uri, nici cine schimbă
#     adresa, nici cine inventează emailuri. Alege-o gândindu-te la o singură
#     întrebare: cât ești dispus să pierzi în cea mai proastă zi posibilă?
MAX_RENDERS_PER_DAY=60
#
#  2. PE BROWSER — asta e limita „pe om". O melodie poate consuma trei
#     înregistrări, iar cine face două cadouri într-o zi ajunge la șase.
MAX_RENDERS_PER_VISITOR_PER_DAY=8
MAX_LYRICS_PER_VISITOR_PER_DAY=10
#
#  3. PE IP — plasă de siguranță, nu limită „pe om". O adresă IP nu e un
#     aparat: o familie pe wi-fi iese pe una singură, iar un operator de mobil
#     trece mii de abonați prin câteva. Ținută jos, bloca oameni străini unii
#     de alții. Ținută sus, tot prinde ce trebuie: patruzeci într-o zi de pe
#     aceeași adresă nu mai e o familie.
MAX_RENDERS_PER_IP_PER_DAY=40
MAX_LYRICS_PER_IP_PER_DAY=80
#
#  4. PE EMAIL — împotriva celui care schimbă browserul dar nu și adresa.
MAX_RENDERS_PER_EMAIL_PER_DAY=6
#
# Cine a plătit vreodată de pe browserul respectiv sare peste 2, 3 și 4.
# Plafonul de la punctul 1 se aplică tuturor.
# Adresele tale, scutite complet de limite. Separate prin virgulă.
# Nu pune aici un IP de VPN sau de Cloudflare WARP: e împărțit cu alți oameni,
# iar scutirea li se aplică și lor.
RATE_LIMIT_EXEMPT_IPS=

# ─── Retenție (conform Politicii de confidențialitate) ───
RETENTION_UNPAID_DAYS=30
RETENTION_PAID_MONTHS=24
