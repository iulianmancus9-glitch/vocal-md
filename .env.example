# ══════════════════════════════════════════════════════════════
#  VOCAL MD — configurare
#  Copiază acest fișier în .env și completează valorile.
#  Nu urca niciodată .env în git.
# ══════════════════════════════════════════════════════════════

# ─── Site ───
NODE_ENV=production
APP_URL=https://vocal.md
# Secret pentru semnarea linkurilor de descărcare și a cookie-urilor de sesiune.
# Generează-l o singură dată cu:  openssl rand -hex 32
APP_SECRET=schimba-ma-openssl-rand-hex-32

# Limba paginii pentru vizitatorii al căror browser nu cere nici română, nici
# engleză. Cine cere română primește română oricum, iar butonul din antet bate
# tot și se ține minte într-un cookie.
#
# Acum e „en", pentru verificarea Paddle: site-ul e verificat din Marea
# Britanie, iar un om care nu înțelege pagina nu poate confirma ce se vinde pe
# ea. După aprobare se pune „ro" aici și se repornește — nimic altceva.
DEFAULT_LANG=en

# ─── Baza de date ───
# În docker compose, hostul este numele serviciului: "db".
DATABASE_URL=postgres://vocal:PAROLA@db:5432/vocalmd
POSTGRES_USER=vocal
POSTGRES_PASSWORD=PAROLA
POSTGRES_DB=vocalmd

# ─── Versuri: Gemini prin OpenRouter ───
OPENROUTER_API_KEY=
GEMINI_MODEL=google/gemini-2.5-pro
GEMINI_TEMPERATURE=0.9

# ─── Melodie: sunoapi.org ───
SUNO_API_KEY=
SUNO_MODEL=V6
# Suno cere obligatoriu un callBackUrl public. Îl verificăm prin semnătură.
SUNO_CALLBACK_URL=https://vocal.md/api/suno/callback

# ─── Fișiere audio ───
# Cale în container; în compose e montat volumul ./data/audio
STORAGE_DIR=/data/audio
PREVIEW_SECONDS=60
# Cât timp e valabil un link de descărcare semnat (secunde). 24h.
DOWNLOAD_LINK_TTL=86400

# ─── Plata: Paddle ───
# Cheile de sandbox și cele de producție sunt diferite. Ține PADDLE_ENV=sandbox
# până ai testat o plată cap-coadă, apoi schimbă toate patru odată cu el.
# Cât timp lipsesc, butonul de cumpărare spune că plata nu e disponibilă.
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_ID=
PADDLE_WEBHOOK_SECRET=
SONG_PRICE_EUR=30

# ─── Export pentru Google Sheets ───
# Generat automat de setup.sh. Apare în adresa pusă în foaie, deci nu-l folosi
# pentru nimic altceva.
EXPORT_KEY=

# ─── Email ───
# Adresa din MAIL_FROM trebuie să fie pe un domeniu verificat în Resend.
# Fără cheie, melodia rămâne în pagină dar nu pleacă niciun email.
RESEND_API_KEY=
MAIL_FROM=Vocal MD <comenzi@vocal.md>
MAIL_REPLY_TO=base.vocalmd@gmail.com

# ─── Câte reluări are voie clientul ───
# Versuri: câte variante noi poate cere înainte de a aproba textul.
MAX_LYRICS_REGENS=2
# Melodie: câte înregistrări în plus poate cere după prima.
# Fiecare costă credite Suno reale, pe o comandă care poate să nu se cumpere.
MAX_EXTRA_RENDERS=2

# ─── Limite anti-abuz ───
# Previzualizarea e gratuită dar costă credite Suno reale. Limităm pe IP și email.
MAX_RENDERS_PER_IP_PER_DAY=9
MAX_RENDERS_PER_EMAIL_PER_DAY=6
MAX_LYRICS_PER_IP_PER_DAY=20
# Adresele tale, scutite complet de limite. Separate prin virgulă.
# Nu pune aici un IP de VPN sau de Cloudflare WARP: e împărțit cu alți oameni,
# iar scutirea li se aplică și lor.
RATE_LIMIT_EXEMPT_IPS=

# ─── Retenție (conform Politicii de confidențialitate) ───
RETENTION_UNPAID_DAYS=30
RETENTION_PAID_MONTHS=24
